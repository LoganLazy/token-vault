# Backend Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
# Options: sqlite | mysql | postgresql
DB_TYPE=sqlite

# SQLite Configuration (default)
SQLITE_FILENAME=./data/totp.db

# MySQL Configuration
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=totp_vault

# PostgreSQL Configuration
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=your_password
# PG_DATABASE=totp_vault

# JWT Configuration
# JWT_SECRET is required in ALL environments (except NODE_ENV=test, which
# has a test-only fallback). At least 32 characters, unique and random.
# Generate with: openssl rand -hex 48
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=12h

# Registration control (v1.5.0): closed by default. When
# REGISTRATION_ENABLED is not "true", registration requires
# REGISTRATION_INVITE_CODE; with no invite code set, all registrations
# are rejected.
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# v1.5.0: DATA_ENCRYPTION_KEY was removed. Sync is end-to-end encrypted
# on the client with each user's master password; the server stores
# opaque tv3: envelopes and cannot decrypt them.
