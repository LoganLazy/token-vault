# ============================================
# 生产环境配置文件
# ============================================
# 复制此文件为 .env.production 并修改以下值
# ============================================

# SQLite 数据加密密钥（32 随机字节，64 个十六进制字符）
DATA_ENCRYPTION_KEY=replace_with_64_hexadecimal_characters

# JWT 密钥（至少 32 字符）
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_at_least_32_characters

# CORS 配置（你的前端域名）
CORS_ORIGIN=https://your-domain.com

# API URL（前端使用）
VITE_API_URL=/api

# 可选：容器写入 SQLite bind mount 时使用的宿主机用户/组 ID。
# deploy.sh 和其他运维脚本默认自动读取当前用户，无需手工设置。
# PUID=1000
# PGID=1000
