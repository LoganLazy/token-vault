# ============================================
# 生产环境配置文件 (v1.5.0)
# ============================================
# 复制此文件为 .env.production 并修改以下值。
# 切勿提交 .env.production，也不要把它放进数据库备份。
# 生成随机值：openssl rand -hex 48
# ============================================

# 公开域名（Caddy 会为它自动申请 Let's Encrypt 证书并强制 HTTPS）。
# 必须是真实域名，DNS 指向这台服务器；不要用 IP 或 localhost。
DOMAIN=vault.example.com

# CORS 配置：必须与 DOMAIN 一致
CORS_ORIGIN=https://vault.example.com

# JWT 密钥（至少 32 字符，唯一随机值；所有环境都必填）
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_at_least_32_characters

# JWT 有效期（默认 12h；改密码 / 退出登录会立即吊销旧 token）
JWT_EXPIRES_IN=12h

# 注册控制（默认关闭）。二选一：
#  - 保持 REGISTRATION_ENABLED=false，并把邀请码私下发给 5-10 位用户；
#  - 或把 REGISTRATION_ENABLED=true 改为开放注册（不推荐）。
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=change-this-invite-code-and-share-it-privately

# API URL（前端使用，保持同源）
VITE_API_URL=/api

# 可选：容器写入 SQLite bind mount 时使用的宿主机用户/组 ID。
# deploy.sh 和其他运维脚本默认自动读取当前用户，无需手工设置。
# PUID=1000
# PGID=1000

# v1.5.0 已移除 DATA_ENCRYPTION_KEY：同步是端到端加密的，secret 在
# 客户端用各用户自己的主密码加密（tv3 信封），服务端只存不透明信封，
# 无法解密。升级到 1.5.0 需要全新数据库，旧库的 secret 无法迁移。
