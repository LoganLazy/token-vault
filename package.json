{
  "name": "token-vault",
  "version": "1.5.0",
  "description": "本地优先、支持加密保护和可选私有同步的 TOTP 验证码管理工具",
  "private": true,
  "type": "module",
  "author": "Token Vault",
  "license": "MIT",
  "keywords": [
    "totp",
    "2fa",
    "authenticator",
    "otp",
    "two-factor",
    "中文",
    "验证码"
  ],
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:analyze": "cross-env NODE_ENV=production vite build --mode analyze",
    "lint": "oxlint",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "crypto-js": "^4.2.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.23.0",
    "otpauth": "^9.5.1",
    "pinyin-pro": "^3.28.1",
    "protobufjs": "^8.7.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "terser": "^5.49.0",
    "vite": "^8.1.5"
  }
}
